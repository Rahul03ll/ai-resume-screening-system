# ==============================================================================
# AI Resume Screening & Ranking System — Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to `.env` and populate any optional keys you wish to use.
# Never commit real secrets to version control.

# Optional: Public GitHub API Personal Access Token
# Increases GitHub API rate limit from 60 req/hr (unauthenticated) to 5,000 req/hr.
GITHUB_TOKEN=

# Optional: LLM Provider & Model Configuration
# Supported providers: auto | groq | openai | gemini
# If no API key is set or an API call fails, the pipeline automatically falls
# back to the deterministic evidence-backed semantic scoring engine.
LLM_PROVIDER=auto
LLM_MODEL=openai/gpt-oss-120b

# Optional LLM Provider API Keys (provide any one if enabling live LLM calls)
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Pipeline Tuning & Feature Flags
ENABLE_GITHUB=true
ENABLE_LLM=true
USE_CACHE=true
MAX_CONCURRENCY=5
GITHUB_TIMEOUT_SEC=8.0
LLM_TIMEOUT_SEC=20.0
